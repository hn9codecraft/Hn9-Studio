# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo

# ---- Environment & secrets ----
.env
.env.*
*.local
secrets.json
credentials.json
*.pem
*.key

# ---- Dependencies ----
node_modules/
vendor/
.venv/
__pycache__/
*.pyc

# ---- Build output ----
dist/
build/
.next/
out/
*.log

# ---- Large / generated media (keep folders, ignore heavy binaries) ----
# Track structure via README.md + .gitkeep, not the raw assets.
Images/Generated/*
Videos/Generated/*
Videos/Final/*
Voice/Voiceovers/*
Voice/Music/*
Voice/Sound Effects/*
Assets/Stock/*
Assets/Music/*
Assets/Videos/*
Output/**/*
!**/README.md
!**/.gitkeep

