APP_NAME="HN9 AI Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hn9_ai_studio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000
# API token lifetime in minutes (0 disables expiry). Default: 10080 (7 days).
SANCTUM_TOKEN_EXPIRATION=10080
# Comma-separated exact browser origins allowed to call the API. No wildcard.
# Production example: CORS_ALLOWED_ORIGINS=https://studio.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional object storage (leave empty for local disks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# Provider keys are optional. Leave disabled unless the matching secret is set.
# Keys may also be managed in-app under AI services; .env values take precedence.
AI_DEFAULT_PROVIDER=

OPENAI_ENABLED=false
OPENAI_API_KEY=

CLAUDE_ENABLED=false
CLAUDE_API_KEY=

GEMINI_ENABLED=false
GEMINI_API_KEY=

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=

# Story video services. Each is used only when its key is set; the highest
# priority connected service is chosen first.
# Seedance 2.0 (BytePlus ModelArk)
SEEDANCE_ENABLED=
ARK_API_KEY=
SEEDANCE_MODEL=dreamina-seedance-2-0-260128
SEEDANCE_RESOLUTION=720p
# Public HTTPS address of this API, for task status callbacks (optional).
SEEDANCE_CALLBACK_BASE_URL=
# Edit/extend need a cloud videos disk that can sign temporary URLs.
SEEDANCE_SIGNED_REFERENCE_VIDEOS=false
# Luma Ray (Luma Agents API)
LUMA_ENABLED=
LUMA_AGENTS_API_KEY=
LUMA_MODEL=ray-3.2
# Runway
RUNWAY_ENABLED=
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4.5

# FFmpeg joins long scenes and builds the final video.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Story cost estimates. Leave a rate empty when the price is not configured.
# STORY_COST_SAFETY_MARGIN=0.10
# STORY_COST_DISPLAY_CURRENCY=INR
# STORY_COST_USD_INR=94
# STORY_COST_RUNWAY_GEN45_PER_SECOND=0.12
# STORY_COST_RUNWAY_ALEPH2_PER_SECOND=0.28
# STORY_COST_LUMA_PER_SECOND=
# STORY_COST_SEEDANCE_PER_SECOND=
# STORY_COST_ELEVENLABS_PER_1K_CHARS=0.08
# STORY_COST_IMAGE_PER_IMAGE=
# STORY_COST_TEXT_PER_1K_TOKENS=

# Voice language (M19). Empty model and voice values use the app default for that language.
STORY_VOICE_DEFAULT_LANGUAGE=en
ELEVENLABS_MODEL_EN=
ELEVENLABS_VOICE_EN=
ELEVENLABS_MODEL_HI=
ELEVENLABS_VOICE_HI=
ELEVENLABS_MODEL_GU=
ELEVENLABS_VOICE_GU=
ELEVENLABS_MULTILINGUAL_MODEL=eleven_multilingual_v2
ELEVENLABS_WIDE_LANGUAGE_MODEL=eleven_v3
ELEVENLABS_LANGUAGE_CODE_MODELS=eleven_v3,eleven_v4,eleven_v4_turbo,eleven_flash_v2_5,eleven_turbo_v2_5
ELEVENLABS_DEFAULT_MODEL=
ELEVENLABS_DEFAULT_VOICE=

# Match scene length to the voiceover (M16).
STORY_VOICE_TIMESTAMPS_ENABLED=true
STORY_VOICE_TIMING_LEAD_IN_MS=300
STORY_VOICE_TIMING_TAIL_MS=500
STORY_VOICE_TIMING_MIN_SCENE_SECONDS=3
STORY_VOICE_TIMING_MAX_SCENE_SECONDS=300
STORY_VOICE_TIMING_ROUND_TO=1

# Subtitles (M16). Leave the font file empty to use the Windows Nirmala UI font.
STORY_SUBTITLE_DISK=exports
STORY_SUBTITLE_FONT_NAME="Nirmala UI"
STORY_SUBTITLE_FONT_FILE=
STORY_SUBTITLE_FONT_SIZE=20
STORY_SUBTITLE_MARGIN_V=24
STORY_SUBTITLE_BURN_CRF=20
STORY_SUBTITLE_BURN_PRESET=veryfast
STORY_SUBTITLE_BURN_TIMEOUT=900

# Background final render (M19). Leave the queue off unless a worker is running.
STORY_RENDER_QUEUE_ENABLED=false
STORY_RENDER_QUEUE_CONNECTION=
STORY_RENDER_QUEUE_NAME=default
STORY_RENDER_JOB_TIMEOUT=1200
STORY_RENDER_STALE_MINUTES=30
STORY_RENDER_WIDTH=1280
STORY_RENDER_HEIGHT=720
STORY_RENDER_FPS=24

# Video generation queue. Leave it off unless a worker is running.
STORY_VIDEO_QUEUE_ENABLED=false
STORY_VIDEO_QUEUE_NAME=default

# Failed-unit retry (M18).
STORY_RETRY_MAX_PER_UNIT=5
