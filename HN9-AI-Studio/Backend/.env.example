APP_NAME="HN9 AI Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hn9_ai_studio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000

# Optional object storage (leave empty for local disks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# Provider keys are optional. Leave disabled unless the matching secret is set.
AI_DEFAULT_PROVIDER=

OPENAI_ENABLED=false
OPENAI_API_KEY=

CLAUDE_ENABLED=false
CLAUDE_API_KEY=

GEMINI_ENABLED=false
GEMINI_API_KEY=

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=

# Story video services. Each is used only when its key is set; the highest
# priority connected service is chosen first.
# Seedance 2.0 (BytePlus ModelArk)
SEEDANCE_ENABLED=
ARK_API_KEY=
SEEDANCE_MODEL=dreamina-seedance-2-0-260128
SEEDANCE_RESOLUTION=720p
# Public HTTPS address of this API, for task status callbacks (optional).
SEEDANCE_CALLBACK_BASE_URL=
# Edit/extend need a cloud videos disk that can sign temporary URLs.
SEEDANCE_SIGNED_REFERENCE_VIDEOS=false
# Luma Ray (Luma Agents API)
LUMA_ENABLED=
LUMA_AGENTS_API_KEY=
LUMA_MODEL=ray-3.2
# Runway
RUNWAY_ENABLED=
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4.5

# FFmpeg joins long scenes and builds the final video.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
